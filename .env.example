# ---------------------------------------------------------------------------
# Local secrets. Ignored by git via `.env*.local`. Never commit this file.
# ---------------------------------------------------------------------------

# OpenRouter — embeddings, reranking, and generation
OPENROUTER_API_KEY=
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_RERANK_MODEL=qwen/qwen3-reranker-8b
OPENROUTER_CHAT_MODEL=stealth/ox-alpha

# Sent as HTTP-Referer / X-Title so the traffic is attributable in the
# OpenRouter dashboard.
OPENROUTER_SITE_URL=https://www.mohab.website
OPENROUTER_SITE_NAME=Mohab Haedarea Portfolio

# Zilliz Cloud (Milvus REST v2).
# ZILLIZ_ENDPOINT is the cluster "Public Endpoint" from the Zilliz console,
# e.g. https://in03-xxxxxxxxxxxx.serverless.gcp-us-west1.cloud.zilliz.com
ZILLIZ_ENDPOINT=
ZILLIZ_TOKEN=username:password
ZILLIZ_COLLECTION=mohab_cv

# Fish Audio — text to speech for the assistant's replies.
# s2.1-pro-free is the free tier of S2.1 Pro (no hard character cap, Fair Use).
# The paid model strings (s2.1-pro, s1) need API credit and will return 402.
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free
FISH_VOICE_ID=d2e75a3e3fd6419893057c02a375a113

# Google Gemini — answer generation (primary).
# OpenRouter stays configured above and is used for embeddings, reranking, and
# as the generation fallback when Gemini returns 503 "high demand".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Groq — answer generation (primary; LPU inference, ~0.6s to first token).
# Gemini and OpenRouter below/above stay configured as ordered fallbacks.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Hugging Face — embeddings (primary). Beats the OpenRouter embedding model on
# measured recall over this CV and is ~8x faster; see lib/rag/huggingface.ts.
# Changing HF_EMBED_MODEL or HF_EMBED_DIM requires re-running pnpm rag:ingest.
HF_API_KEY=
HF_EMBED_MODEL=BAAI/bge-large-en-v1.5
HF_EMBED_DIM=1024

# LLM7 — generation fallback #1. Separate quota from Groq, so a Groq rate limit
# costs ~0.5s instead of dropping to a slower provider.
LLM7_API_KEY=
LLM7_MODEL=gemini-3.1-flash-lite
